# ==========================================
# Department GPU Management System - Production Configuration
# Copy this file to .env and customize secrets before deployment
# ==========================================

# Database Configuration
POSTGRES_USER=gpu_user
POSTGRES_PASSWORD=gpu_production_password_change_me
POSTGRES_DB=gpu_allocator
DATABASE_URL=postgresql://gpu_user:gpu_production_password_change_me@db:5432/gpu_allocator

# Backend & Security Configuration
PORT=8010
NODE_ENV=production
JWT_SECRET=production_super_secret_jwt_key_replace_this_min32chars
JWT_EXPIRES_IN=24h
CORS_ORIGINS=http://localhost,http://localhost:3000,http://127.0.0.1:3000

# Policy & Escalation Settings
ESCALATION_TIMEOUT_MINUTES=60
TELEMETRY_RETENTION_DAYS=7

# Frontend Public Endpoints
NEXT_PUBLIC_API_URL=http://localhost/api
NEXT_PUBLIC_WS_URL=ws://localhost/ws/status
